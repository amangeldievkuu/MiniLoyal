{
  "name": "@miniloyal/sdk",
  "version": "0.3.0",
  "description": "MiniLoyal client for LINE MINI Apps: LIFF login, member sessions, profile, consent, friendship, member card and points",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./src/api/schema.d.ts"
    }
  },
  "files": [
    "dist",
    "src/api",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-size.mjs",
    "dev": "tsup --watch",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@line/liff": "^2.26.0"
  }
}
