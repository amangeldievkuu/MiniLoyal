# Copy to .env for local development. Values here are safe defaults for docker compose.

# Postgres (docker compose "db" service, bound to 127.0.0.1; 5434 avoids the local Homebrew Postgres on 5432)
POSTGRES_USER=miniloyal
POSTGRES_PASSWORD=miniloyal
POSTGRES_DB=miniloyal
POSTGRES_PORT=5434

# API
# The API connects as miniloyal_api and the worker as miniloyal_worker (RLS applies to both);
# migrations connect as the owner and set both roles' passwords.
DATABASE_URL=postgres://miniloyal_api:miniloyal_api@127.0.0.1:5434/miniloyal?sslmode=disable
WORKER_DATABASE_URL=postgres://miniloyal_worker:miniloyal_worker@127.0.0.1:5434/miniloyal?sslmode=disable
MIGRATE_DATABASE_URL=postgres://miniloyal:miniloyal@127.0.0.1:5434/miniloyal?sslmode=disable
APP_DB_PASSWORD=miniloyal_api
WORKER_DB_PASSWORD=miniloyal_worker
# Integration tests create throwaway databases through this owner connection.
TEST_DATABASE_URL=postgres://miniloyal:miniloyal@127.0.0.1:5434/miniloyal?sslmode=disable
API_ADDR=:8080
ENV=development            # development | staging | production
LOG_LEVEL=debug            # debug | info | warn | error
LOG_FORMAT=text            # text | json
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_ORIGIN=http://localhost:5173
TRUST_PROXY=false           # true behind the nginx container
# Development only: store LINE channel credentials without checking them against LINE.
# LINE_SKIP_CREDENTIAL_VERIFICATION=true

# Secrets (generate with: openssl rand -base64 32). Required outside development.
SESSION_SIGNING_KEY=
# Envelope encryption: a local KEK file in development, Cloud KMS key in production.
KEK_FILE=.kek
KMS_KEY_NAME=

# Worker
WORKER_CONCURRENCY=4

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
